{
  "manifest_version": 3,
  "name": "better bookmarks",
  "version": "1.0.1",
  "description": "A new tab page for your bookmarks. Organize folders, search bookmarks and browsing history, and navigate with your keyboard.",
  "permissions": [
    "storage",
    "tabGroups",
    "history",
    "contextMenus",
    "bookmarks",
    "search"
  ],
  "host_permissions": [
    "https://a.favicon.im/*"
  ],
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "better bookmarks"
  },
  "background": {
    "service_worker": "background.js"
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
